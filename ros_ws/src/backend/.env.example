# Backend ROS 2 — Environment Variables
# JANGAN commit file ini ke git! Sudah ada di .gitignore.
#
# Cara pakai:
#   source .env  (bash)
#   atau: export BACK4APP_APP_ID=xxx sebelum ros2 run

# Back4App credentials — ROTATE dulu di dashboard Back4App!
BACK4APP_APP_ID=GANTI_DENGAN_APP_ID_BARU
BACK4APP_REST_KEY=GANTI_DENGAN_REST_KEY_BARU

# Interval upload ke Back4App (detik)
UPLOAD_INTERVAL=5

# Paket pesan: 'backend' untuk dummy, 'kki_26' untuk robot asli
ASV_MSG_PKG=backend

# Throttle node web_monitor_node
VIDEO_FPS=3
TELEMETRY_HZ=2
